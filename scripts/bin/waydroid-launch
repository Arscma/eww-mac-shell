#!/usr/bin/env bash
if ! systemctl is-active --quiet waydroid-container; then
  pkexec systemctl start waydroid-container || exit 1
  for _ in $(seq 1 10); do
    systemctl is-active --quiet waydroid-container && break
    sleep 1
  done
fi

running() { waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING'; }

if ! running; then
  nohup waydroid session start >/dev/null 2>&1 &
  for _ in $(seq 1 30); do
    running && break
    sleep 1
  done
fi

exec waydroid show-full-ui
