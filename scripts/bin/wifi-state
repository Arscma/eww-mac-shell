#!/usr/bin/env bash
# deflisten: output off | disconnected | noinet | ok
RECHECK=120

state() {
  [ "$(nmcli radio wifi)" != "enabled" ] && { echo off; return; }
  nmcli -t -f TYPE,STATE device | grep -q '^wifi:connected' || { echo disconnected; return; }
  c=$(nmcli networking connectivity)
  if [ "$c" = "unknown" ]; then
    ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 && c=full || c=none
  fi
  [ "$c" = "full" ] && echo ok || echo noinet
}

last=""
emit() { s=$(state); [ "$s" != "$last" ] && { echo "$s"; last="$s"; }; }

emit
exec 3< <(nmcli monitor)
while true; do
  if [ "$RECHECK" -gt 0 ]; then read -r -t "$RECHECK" _ <&3; else read -r _ <&3; fi
  rc=$?
  [ $rc -eq 1 ] && break
  while read -r -t 0.3 _ <&3; do :; done
  emit
done
