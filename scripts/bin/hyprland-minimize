#!/usr/bin/env bash
dsp() { hyprctl dispatch "$1" >/dev/null; }
case "$1" in
  minimize)
    win=$(hyprctl activewindow -j)
    addr=$(jq -r '.address // empty' <<<"$win")
    [ -z "$addr" ] && exit 0
    geo=$(jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' <<<"$win")
    grim -g "$geo" "/tmp/$addr.png"
    dsp "hl.dsp.window.move({ workspace = \"special:minimized\", follow = false, window = \"address:$addr\" })"
    echo "/tmp/$addr.png"
    ;;
  list)
    fb="/usr/share/icons/WhiteSur/apps@2x/scalable/view-app-grid.svg"
    have=$(ls /tmp | grep -E '^0x.*\.png$' | sed 's/\.png$//' | jq -R . | jq -sc .)
    hyprctl clients -j | jq -c --argjson have "$have" --arg fb "$fb" '
      [ .[] | select(.mapped and (.workspace.name | startswith("special")))
        | . as $c
        | [$c.initialTitle, $c.address,
           (if ($have | index($c.address)) != null then "/tmp/\($c.address).png" else $fb end)] ]'
    ;;
  restore)
    addr="$2"
    [ -z "$addr" ] && { echo "No window address supplied" >&2; exit 1; }
    ws=$(hyprctl activeworkspace -j | jq -r '.id')
    dsp "hl.dsp.window.move({ workspace = $ws, follow = true, window = \"address:$addr\" })"
    dsp "hl.dsp.focus({ window = \"address:$addr\" })"
    rm -f "/tmp/$addr.png"
    ;;
  focus)
    dsp "hl.dsp.focus({ window = \"address:$2\" })"
    ;;
  *) echo "Unknown command" >&2; exit 1 ;;
esac
