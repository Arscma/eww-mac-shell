#!/usr/bin/env python3
import json, urllib.request, datetime

URL = ("https://api.open-meteo.com/v1/forecast?latitude=-6.9175&longitude=107.6191"
       "&daily=weather_code,temperature_2m_max,temperature_2m_min"
       "&forecast_days=3&timezone=Asia%2FBangkok")

def icon(c):
    if c == 0: return "\U000F0599"      # sunny
    if c <= 2: return "\U000F0595"      # partly cloudy
    if c == 3: return "\U000F0590"      # cloudy
    if c <= 48: return "\U000F0591"     # fog
    if c <= 67: return "\U000F0597"     # rain
    if c <= 77: return "\U000F0598"     # snow
    if c <= 82: return "\U000F0596"     # showers
    return "\U000F0593"                 # thunder

try:
    d = json.load(urllib.request.urlopen(URL, timeout=8))["daily"]
    days = []
    for i in range(3):
        dt = datetime.date.fromisoformat(d["time"][i])
        days.append({
            "label": ["TODAY", "TOMORROW", ""][i],
            "name": dt.strftime("%A").upper(),
            "date": dt.strftime("%d/%m/%y"),
            "hi": round(d["temperature_2m_max"][i]),
            "lo": round(d["temperature_2m_min"][i]),
            "icon": icon(d["weather_code"][i]),
            "today": i == 0,
        })
    print(json.dumps({"days": days}))
except Exception:
    print(json.dumps({"days": []}))
