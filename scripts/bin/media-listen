#!/usr/bin/env python3
import ctypes, glob, hashlib, json, os, queue, shutil, signal, subprocess, threading, time, urllib.request

N_TITLE, N_ARTIST = 26, 32
HOLD, STEP, END_HOLD = 5.0, 0.12, 1.5
ART = "/tmp/eww-cover"
import os

FALLBACK_GIF = os.path.expanduser("~/.config/eww/assets/no-media-cover.png")
os.makedirs(ART, exist_ok=True)

libc = ctypes.CDLL("libc.so.6")
die_with_parent = lambda: libc.prctl(1, signal.SIGTERM)
die_with_parent()

now = time.time()
for f in os.listdir(ART):
    p = os.path.join(ART, f)
    if now - os.path.getmtime(p) > 172800:
        os.remove(p)

q = queue.Queue()

def reader():
    while True:
        try:
            players = subprocess.run(
                ["playerctl", "-l"],
                capture_output=True,
                text=True,
                timeout=3
            ).stdout.splitlines()

            if not players:
                q.put(("meta", ""))
                time.sleep(2)
                continue

            candidates = []

            for player in players:
                try:
                    status = subprocess.run(
                        ["playerctl", "-p", player, "status"],
                        capture_output=True,
                        text=True,
                        timeout=2
                    ).stdout.strip()

                    priority = (
                        0 if status == "Playing"
                        else 1 if status == "Paused"
                        else 2
                    )
                    candidates.append((priority, player))
                except Exception:
                    continue

            candidates.sort()

            if not candidates:
                q.put(("meta", ""))
                time.sleep(2)
                continue

            _, player = candidates[0]

            fmt = "{{status}}\t{{artist}}\t{{title}}\t{{mpris:artUrl}}"

            p = subprocess.Popen(
                [
                    "playerctl", "-p", player,
                    "metadata", "--follow", "--format", fmt
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                preexec_fn=die_with_parent
            )

            for line in p.stdout:
                q.put(("meta", line.rstrip("\n")))

            p.wait()

        except Exception:
            pass

        q.put(("meta", ""))
        time.sleep(2)

def fetch(url):
    path = os.path.join(ART, hashlib.sha1(url.encode()).hexdigest())
    if not os.path.exists(path):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=5) as r, open(path + ".tmp", "wb") as f:
                f.write(r.read())
            os.replace(path + ".tmp", path)
        except Exception:
            return
    q.put(("art", url, "file://" + path))

s = {"title": "Not Playing", "artist": "", "playing": False, "art_url": "", "art": "", "step": 0}
phase, deadline = "idle", None

def overflow():
    return max(len(s["title"]) - N_TITLE, len(s["artist"]) - N_ARTIST, 0)

def cc_open():
    try:
        out = subprocess.run(["eww", "get", "control_center_open"],
                             capture_output=True, text=True, timeout=2).stdout
        return out.strip() == "true"
    except Exception:
        return False

def emit():
    ot = max(0, min(s["step"], len(s["title"]) - N_TITLE))
    oa = max(0, min(s["step"], len(s["artist"]) - N_ARTIST))
    art = s["art"].replace("'", "%27")
    style = ("background-image: url('%s'); background-size: cover; background-position: center;" % art
             if art else
             "background-image: url('file://%s'); background-size: cover; background-position: center;" % FALLBACK_GIF)
    print(json.dumps({
        "title": s["title"][ot:ot + N_TITLE],
        "artist": s["artist"][oa:oa + N_ARTIST],
	"playing": s["playing"],
	"cover_style": style,
	"cover_available": bool(s["art"]),
    }, ensure_ascii=False), flush=True)

threading.Thread(target=reader, daemon=True).start()
emit()

while True:
    wait = None if deadline is None else max(0.0, deadline - time.time())
    try:
        ev = q.get(timeout=wait)
    except queue.Empty:
        ev = None

    if ev is not None:
        if ev[0] == "meta":
            status, artist, title, url = (ev[1].split("\t") + ["", "", "", ""])[:4]
            if status in ("Playing", "Paused"):
                s["playing"] = status == "Playing"
                s["title"] = title.replace("\n", " ") or "Unknown"
                s["artist"] = artist.replace("\n", " ")
            else:
                s.update(playing=False, title="Not Playing", artist="")
                url = ""

            if url != s["art_url"]:
                s["art_url"], s["art"] = url, ""
                if url.startswith("file://"):
                    from urllib.parse import unquote, urlparse
                    local_path = unquote(urlparse(url).path)

                    if not os.path.isfile(local_path) and local_path.startswith("/tmp/"):
                        for base in glob.glob("/run/user/*/.flatpak/*/tmp"):
                            alt = os.path.join(base, local_path[5:])
                            if os.path.isfile(alt):
                                local_path = alt
                                break

                    if os.path.isfile(local_path) and os.access(local_path, os.R_OK):
                        dest = os.path.join(ART, hashlib.sha1((url + str(os.path.getmtime(local_path))).encode()).hexdigest())
                        try:
                            shutil.copy(local_path, dest)
                            s["art"] = "file://" + dest
                        except Exception:
                            pass
                elif url.startswith(("http://", "https://")):
                    threading.Thread(target=fetch, args=(url,), daemon=True).start()

            s["step"] = 0
            if s["playing"] and overflow() > 0:
                phase, deadline = "hold", time.time() + HOLD
            else:
                phase, deadline = "idle", None
            emit()
            continue

        elif ev[0] == "art":
            if ev[1] == s["art_url"]:
                s["art"] = ev[2]
                emit()
            continue
            
    if phase == "hold":
        if not cc_open():
            deadline = time.time() + HOLD
            continue
        phase = "slide"
    if phase == "slide":
        s["step"] += 1
        emit()
        if s["step"] >= overflow():
            phase, deadline = "end", time.time() + END_HOLD
        else:
            deadline = time.time() + STEP
    elif phase == "end":
        s["step"] = 0
        emit()
        phase, deadline = "hold", time.time() + HOLD
