(defwindow control_center
    :monitor 0
    :namespace "eww-control-center"
    :exclusive false
    :geometry (geometry :width "520px" :y "-16px" :x "-25px" :anchor "top right")
    :stacking "fg"
    :wm-ignore false
    :class "dark"
    (revealer :reveal control_center_open :transition "slidedown" :duration "250ms"
        (eventbox ;; :onhoverlost "eww update control_center_open='false'"
        (box :class "container" :space-evenly false :spacing 16 :orientation "vertical"
            (box :spacing 16
                (quick_settings)
                (media_player)
            )
            (box
                :class "slider control"
                :orientation "vertical"
                :space-evenly false
                :spacing 8
                (label :xalign 0 :text "Display")
                (box :space-evenly false :spacing 10
                    (image :valign "center" :image-width 16 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/display-brightness-low-symbolic.svg")
                    (scale :class "scale" :hexpand true :value brightness :min 0 :max 100 :onchange "brightnessctl s $(printf '%.0f' {})% && eww update brightness='{}'")
                    (image :valign "center" :image-width 16 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/display-brightness-high-symbolic.svg")
                )
            )
            (box
                :class "slider control"
                :orientation "vertical"
                :space-evenly false
                :spacing 8
                (button
                    :halign "start"
                    :onclick "setsid -f sh -c 'eww update control_center_open=false; pavucontrol' >/dev/null 2>&1"
                    (label :text "Sound"))
                (box :space-evenly false :spacing 10
                    (image :valign "center" :image-width 16 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/audio-volume-muted-symbolic.svg")
                    (scale :class "scale" :hexpand true :value volume :min 0 :max 100 :onchange "pactl set-sink-volume @DEFAULT_SINK@ $(printf '%.0f' {})%")
                    (image :valign "center" :image-width 16 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/audio-volume-high-symbolic.svg")
                )
            )
            (box :class "control toggles" :space-evenly true
                (button
                    :class "toggle"
                    :halign "center"
                    :tooltip "Theme"
    		    :onclick "setsid -f ./scripts/toggle-theme.sh >/dev/null 2>&1"
                    (image :image-width 30 :path "/usr/share/icons/WhiteSur-dark/actions/symbolic/dark-mode-symbolic.svg"))
                (button
                    :class "toggle"
                    :halign "center"
                    :tooltip "Game Mode"
                    :onclick "setsid -f $HOME/.config/eww/scripts/gamemode/gamemode.sh >/dev/null 2>&1"
                    (image :image-width 30 :path "/usr/share/icons/WhiteSur-dark/actions/symbolic/gamepad-symbolic.svg"))
                (button
                    :class "toggle"
                    :halign "center"
                    :tooltip "Screenshot"
                    :onclick "setsid -f sh -c 'eww update control_center_open=false; sleep 0.5; hyprscreen' >/dev/null 2>&1"
                    (image :image-width 30 :path "/usr/share/icons/WhiteSur-dark/apps/symbolic/accessories-screenshot-symbolic.svg"))
                (button
                    :class "toggle"
                    :halign "center"
		    :tooltip "Panel Tint"
		    :onclick "setsid -f sh -c 'm=${panel_tint == 'on' ? 'off' : 'on'}; eww update panel_tint=$m; echo $m > $HOME/.config/eww/scripts/status/.panel-tint' >/dev/null 2>&1"
		    :onrightclick "setsid -f sh -c 'm=${panel_bg == 'shadow' ? 'clear' : 'shadow'}; eww update panel_bg=$m; echo $m > $HOME/.config/eww/scripts/status/.panel-bg' >/dev/null 2>&1"
                    (image :image-width 30 :path "/usr/share/icons/WhiteSur-dark/actions/symbolic/color-gradient-symbolic.svg"))
;;	    )
;;	    (box :class "control toggles" :space-evenly true
;;		(box)
;;		(box)
;;		(box)
;;              (button
;;                  :class "toggle"
;;                  :halign "center"
;;                  :tooltip "?"
;;                  :onclick "setsid -f ... >/dev/null 2>&1"
;;                  (image :image-width 30 :path "/usr/share/icons/WhiteSur-dark/actions/symbolic/view-refresh-symbolic.svg"))
            )
        )
        )
    )
)

(defwidget quick_settings[]
    (box :class "control" :orientation "vertical" :space-evenly false :spacing 0
        (box :class "qs-row wifi-row" :space-evenly false :spacing 12 :valign "end"
            (box :orientation "vertical" :hexpand true :valign "center"
                (button
                    :halign "start"
                    :onclick "setsid -f sh -c 'eww update control_center_open=false; nmgui' >/dev/null 2>&1"
                    (label :text "Wi-Fi"))
                (label :xalign 0 :class "muted" :text "${wifi_enabled == 'enabled' ? (wifi_name == '' ? 'Not connected' : (strlength(wifi_name) > 22 ? captures(wifi_name, '.{0,21}')[0][0] + '...' : wifi_name)) : 'Off'}")
            )
            (button
                :class "switch"
                :halign "end"
                :valign "center"
                :onclick "setsid -f sh -c 'eww update wifi_enabled=${wifi_enabled == 'enabled' ? 'disabled' : 'enabled'}; nmcli radio wifi ${wifi_enabled == 'enabled' ? 'off' : 'on'}' >/dev/null 2>&1"
                (box :class "knob ${wifi_enabled == 'enabled' ? 'on' : 'off'}" :halign "start" :valign "center"))
        )
        (box :class "qs-row dock-row" :vexpand true :valign "center" :space-evenly false :spacing 12
            (box :orientation "vertical" :hexpand true :valign "center"
                (button
                   :halign "start"
                   :onclick "setsid -f sh -c 'm=${dock_floating ? 'false' : 'true'}; eww update dock_floating=$m; echo $m > $HOME/.config/eww/scripts/status/.dock-floating' >/dev/null 2>&1"
;; :onclick "eww update dock_floating=true"
;; :onrightclick "eww update dock_floating=false"
                   (label :text "Dock"))
                (label :xalign 0 :class "muted" :text "${dock_mode == 'smart' ? 'Smart hide' : 'Auto-hide'}")
            )
            (button
                :class "switch"
                :halign "end"
                :valign "center"
                :onclick "setsid -f sh -c 'm=${dock_mode == 'smart' ? 'autohide' : 'smart'}; eww update dock_mode=$m; echo $m > $HOME/.config/eww/scripts/status/.dock-mode' >/dev/null 2>&1"
                (box :class "knob ${dock_mode == 'smart' ? 'on' : 'off'}" :halign "start" :valign "center"))
        )
        (box :class "qs-row bt-row" :space-evenly false :spacing 12
            (box :orientation "vertical" :hexpand true :valign "center"
                (button
                    :halign "start"
                    :onclick "setsid -f sh -c 'eww update control_center_open=false; blueman-manager' >/dev/null 2>&1"
                    (label :text "Bluetooth"))
                (label :xalign 0 :class "muted" :text "${bt_state == 'off' ? 'Off' : (bt_state == 'on' ? 'On' : (strlength(bt_state) > 22 ? captures(bt_state, '.{0,21}')[0][0] + '...' : bt_state))}")
        )
        (button
            :class "switch"
            :halign "end"
            :valign "center"
            :onclick "setsid -f sh -c 'eww update bt_state=${bt_state == 'off' ? 'on' : 'off'}; bluetoothctl power ${bt_state == 'off' ? 'on' : 'off'}' >/dev/null 2>&1"
            (box :class "knob ${bt_state != 'off' ? 'on' : 'off'}" :halign "start" :valign "center"))
        )
        (box :orientation "vertical" :spacing 2 :valign "end"
            (label :xalign 0.5 :text "Battery: ${EWW_BATTERY["BAT0"]["capacity"]}%")
            (box :class "segmented" :halign "center" :space-evenly false :spacing 12
                (button :class "seg ${power_profile == 'performance' ? 'active' : ''}" :tooltip "Performance" :halign "center" :valign "center"
                    :onclick "powerprofilesctl set performance && eww update power_profile=performance"
                    (image :image-width 18 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/power-profile-performance-symbolic.svg"))
                (button :class "seg ${power_profile == 'balanced' ? 'active' : ''}" :tooltip "Balanced" :halign "center" :valign "center"
                    :onclick "powerprofilesctl set balanced && eww update power_profile=balanced"
                    (image :image-width 18 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/power-profile-balanced-symbolic.svg"))
                (button :class "seg ${power_profile == 'power-saver' ? 'active' : ''}" :tooltip "Power Saver" :halign "center" :valign "center"
                    :onclick "powerprofilesctl set power-saver && eww update power_profile=power-saver"
                    (image :image-width 18 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/power-profile-power-saver-symbolic.svg"))
            )
        )
    )
)

(defwidget media_player[]
    (box :class "control media" :orientation "vertical" :space-evenly false :spacing 6
        (box :class "cover" :halign "start" :style "${media.cover_style}")
        (label :class "m-title" :xalign 0 :text "${media.title}" :limit-width 30)
        (label :class "m-artist" :xalign 0 :text "${media.artist}" :limit-width 36)
        (box :class "m-seek" :space-evenly false :spacing 6
            (label :class "m-time" :text "${floor(media_t.pos / 60000000)}:${media_t.pos / 1000000 % 60 < 10 ? '0' : ''}${floor(media_t.pos / 1000000 % 60)}")
            (scale :class "seek-scale" :hexpand true :min 0
                   :value {media_t.pos / 1000000}
                   :max {media_t.len > 0 ? media_t.len / 1000000 : 1}
                   :onchange "playerctl position {}")
            (label :class "m-time" :text "${floor(media_t.len / 60000000)}:${media_t.len / 1000000 % 60 < 10 ? '0' : ''}${floor(media_t.len / 1000000 % 60)}")
        )
        (box :class "m-controls" :halign "center" :valign "end" :vexpand true :space-evenly false :spacing 22
            (button :onclick "setsid -f playerctl previous >/dev/null 2>&1"
                (label :class "m-btn" :text "󰒮"))
            (button :onclick "setsid -f playerctl play-pause >/dev/null 2>&1"
                (label :class "m-btn m-play" :text "${media.playing ? '󰏤' : '󰐊'}"))
            (button :onclick "setsid -f playerctl next >/dev/null 2>&1"
                (label :class "m-btn" :text "󰒭"))
        )
    )
)
