{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "ignore-gtk-theme": true,

  "control-center-layer": "top",
  "cssPriority": "user",
  "control-center-width": 350,
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,

  "notification-window-width": 400,
  "notification-body-image-height": 200,
  "notification-body-image-width": 200,
  "notification-grouping": true,
  "notification-window-height": -1,

  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,

  "scripts": {
    "normal": {
      "exec": "bash \"$HOME/.config/eww/apps/swaync/scripts/normal.sh\"",
      "app-name": ".*",
      "urgency": "Normal"
    },
    "critical": {
      "exec": "bash \"$HOME/.config/eww/apps/swaync/scripts/critical.sh\"",
      "app-name": ".*",
      "urgency": "Critical"
    }
  },

  "widgets": [
    "title",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notification Centre",
      "clear-all-button": true,
      "button-text": ""
    },
    "notifications": {
      "vexpand": false
    }
  }
}
