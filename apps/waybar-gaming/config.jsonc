{
  "layer": "top",
  "position": "bottom",
  "height": 22,
  "spacing": 12,

  "modules-left": [
    "network",
    "clock",
    "cpu",
    "custom/ram",
    "custom/gpu",
    "custom/cputemp",
    "custom/gputemp",
    "battery",
    "custom/ssdtemp"
  ],
  "modules-right": [
    "custom/audio",
    "custom/launcher",
    "custom/power"
  ],

  "network": {
    "interval": 5,
    "format-wifi": "<span color='#e05555'>{icon}</span> {signalStrength}%",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "<span color='#e05555'>󰈀</span> LAN",
    "format-disconnected": "<span color='#e05555'>󰤭</span> Off",
    "tooltip": false,
    "on-click": "setsid -f nmgui >/dev/null 2>&1"
  },

  "clock": {
    "interval": 10,
    "format": "<span color='#e05555'>󰥔</span> {:%H:%M}",
    "tooltip": false
  },

  "cpu": {
    "interval": 2,
    "format": "<span color='#e05555'>󰘚</span> {usage}%",
    "tooltip": false
  },

  "custom/ram": {
    "interval": 3,
    "exec": "awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{u=(t-a)/1024; if(u>=1024) printf \"%.1fGB\", u/1024; else printf \"%dMB\", u}' /proc/meminfo",
    "format": "<span color='#e05555'>󰍛</span> {}",
    "tooltip": false
  },

  "custom/gpu": {
    "interval": 2,
    "exec": "cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -1",
    "format": "<span color='#e05555'>󰢮</span> {}%",
    "tooltip": false
  },

  "custom/cputemp": {
    "interval": 3,
    "exec": "$HOME/.config/eww/apps/waybar-gaming/scripts/temp.sh k10temp",
    "format": "<span color='#e05555'>󰔏</span> CPU {}°",
    "tooltip": false
  },

  "custom/gputemp": {
    "interval": 3,
    "exec": "$HOME/.config/eww/apps/waybar-gaming/scripts/temp.sh amdgpu",
    "format": "<span color='#e05555'>󰔏</span> GPU {}°",
    "tooltip": false
  },

  "battery": {
    "interval": 30,
    "bat": "BAT0",
    "states": { "warning": 25, "critical": 12 },
    "format": "<span color='#e05555'>{icon}</span> {capacity}%",
    "format-charging": "<span color='#e05555'>󰂄</span> {capacity}%",
    "format-plugged": "<span color='#e05555'>󰚥</span> {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": false
  },

  "custom/ssdtemp": {
    "interval": 5,
    "exec": "$HOME/.config/eww/apps/waybar-gaming/scripts/temp.sh nvme",
    "format": "<span color='#e05555'>󰋊</span> SSD {}°",
    "tooltip": false
  },

  "custom/audio": {
    "format": "󰕾",
    "tooltip": false,
    "on-click": "setsid -f pavucontrol >/dev/null 2>&1"
  },

  "custom/launcher": {
    "format": "󰀻",
    "tooltip": false,
    "on-click": "setsid -f wofi --show drun >/dev/null 2>&1"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "setsid -f $HOME/.config/eww/scripts/gamemode/gamemode.sh >/dev/null 2>&1"
  }
}
